# API Python de parsing Excel pour les arrivages
PUBLIC_ARRIVAGE_API_URL=https://arrivage.nokk-project.example
PUBLIC_NEWSLETTER_API_URL=https://newsletter.nokk-project.example
# Service packing-api (Python) : import et classement des packing lists, voir docs/flow-limited-technical.md 3.6.
# Sans cette variable, le dev simule l'import dans le navigateur (sans modele appris).
# Absent en developpement : l'import passe par le faux import du navigateur.
# Absent en PRODUCTION : l'import echoue explicitement, ce n'est pas un repli.
# PUBLIC_PACKING_API_URL=https://packing.nokk-project.example

# Service scan-doc (Go) : fiches de stock scannées ou photographiées → classeur Excel,
# onglet Stock › Scan. Absent : l'onglet affiche « service non configuré ».
# PUBLIC_SCAN_DOC_URL=https://scan-doc.nokk-project.example

# Webhook n8n déclenché par la veille RH (optionnel — une URL de repli est codée en dur si absent)
# Renommé depuis VITE_N8N_WEBHOOK_URL (préfixe non exposé côté client par rsbuild, voir docs/PLAN_ASSAINISSEMENT.md §7.3)
PUBLIC_N8N_WEBHOOK_URL=https://n8n.nokk-project.example/webhook/veille-rh

# Configuration du cache de tests distribué

# Synchronisation automatique du cache vers le VPS (optionnel)
PUSH_TEST_CACHE=false  # true pour activer la synchronisation automatique

# Configuration SSH du VPS (si synchronisation activée)
REMOTE_HOST=root@nokk-project.example
REMOTE_PATH=/root/github_webhook/cache/test-cache

# Debug des opérations cryptographiques (PAKE, chiffrement, etc.)
# Affiche des logs détaillés dans la console pour le débogage
# PUBLIC_* est le seul préfixe exposé côté client par rsbuild — voir docs/PLAN_ASSAINISSEMENT.md §7.3
PUBLIC_ENABLE_CRYPTO_DEBUG=false  # true pour activer les logs de débogage crypto

# Cloudflare Turnstile (captcha login)
PUBLIC_TURNSTILE_SITE_KEY=
