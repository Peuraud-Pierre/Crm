{
    "name": "Nokk_project",
    "private": true,
    "version": "1.8.0",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "rsbuild dev",
        "dev:local": "rsbuild dev --env-mode localdb",
        "build": "rsbuild build --env-mode \"${RSBUILD_MODE:-production}\" && node workbox-build.js",
        "preview": "rsbuild preview",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "check:lint-ratchet": "node scripts/check-quality-ratchet.mjs lint",
        "check:typecheck-ratchet": "node scripts/check-quality-ratchet.mjs typecheck",
        "tech-debt:report": "node scripts/tech-debt-report.mjs --write",
        "test": "rstest",
        "test:watch": "rstest -w",
        "test:front": "rstest run src",
        "test:isolated": "rstest run src --pool forks --isolate",
        "doctor": "RSDOCTOR=true npm run build",
        "db:migrate:apply": "bash scripts/apply-watch-config-migration.sh",
        "db:migrate:verify": "node scripts/verify-migration.mjs",
        "db:migrate:test": "rstest run tests/migrations",
        "db:start": "supabase --workdir local-db start",
        "db:stop": "supabase --workdir local-db stop",
        "db:reset": "supabase --workdir local-db db reset",
        "db:otp": "node scripts/local-db/otp.mjs"
    },
